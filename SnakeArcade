import streamlit as st
import random
import time

# 1. ตั้งค่าหน้าเว็บให้เป็นธีมหน้าเกม
st.set_page_config(page_title="Snake Game: Arcade Edition", page_icon="🐍", layout="centered")

# ตกแต่ง CSS ให้หน้าจอมีสไตล์ตู้เกมย้อนยุค
st.markdown("""
    <style>
